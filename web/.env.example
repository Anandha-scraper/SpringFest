# Firebase web config — public by design, same values as the old frontend/.env
# with VITE_ swapped for NEXT_PUBLIC_ (that is Next's build-time inlining prefix).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Where app/api/[...path]/route.js forwards to. Server-side only — deliberately
# NOT NEXT_PUBLIC_, because the browser must keep talking to its own origin.
# Local dev: the Express server on :8000. Production: the API backend's URL.
API_ORIGIN=http://localhost:8000
