    "@radix-ui/react-alert-dialog": "^1.1.23",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-slot": "^1.3.3",
    "chart.js": "^4.5.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "firebase": "^10.14.0",
    "gsap": "^3.15.0",
    "html5-qrcode": "^2.3.8",
    "lucide-react": "^1.35.0",
    "motion": "^13.1.1",
    "next": "15.2.9",
    "ogl": "^1.0.11",
    "react": "^18.3.1",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^3.6.0"
  },
