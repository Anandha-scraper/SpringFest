# Path to the Firebase Admin SDK service account key (see README).
# Leave as-is on Cloud Run, where Application Default Credentials are used instead.
FIREBASE_CREDENTIALS=./serviceAccountKey.json

# Firestore database id. Use "(default)" unless you created a *named* database —
# the id must match the console exactly, or every call 404s.
FIRESTORE_DATABASE_ID=(default)

# Razorpay keys. The id is sent to the browser to open Checkout; the secret is
# server-only and signs/verifies payments.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=

# Comma-separated origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173

# Comma-separated emails granted admin on Google sign-in. Case-insensitive.
ADMIN_EMAILS=you@example.com
