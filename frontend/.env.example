# Backend base URL. Include the /api prefix.
VITE_API_BASE=http://localhost:8000/api

# Firebase web config: console > Project settings > Your apps > Web app > Config.
# These are public by design — they identify the project, they don't authorise it.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_APP_ID=
